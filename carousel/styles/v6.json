{
  "name": "v6",
  "label": "Luminous Duotone",
  "extends": "_base",
  "meta": {
    "description": "A restrained painterly jewel-tone wash that blooms *with* the dark photo as a signature glow, rather than an opaque layer that buries it. The wash renders at low resolution from a few blurred colour blobs and upscales, which smooths the gradient and kills banding for free.",
    "tags": ["dark", "gradient", "colourful"]
  },

  "canvas": { "margin": 96 },

  "palette": {
    "scrim": [16, 17, 21],
    "text": [240, 237, 231],
    "dim": [206, 203, 197],
    "muted": [150, 152, 158],
    "a": [232, 150, 60],
    "b": [196, 58, 128],
    "accent": [244, 196, 132]
  },

  "variants": {
    "amber-magenta": { "a": [232, 150, 60], "b": [196, 58, 128], "accent": [244, 196, 132] },
    "teal-indigo": { "a": [48, 170, 164], "b": [78, 86, 200], "accent": [150, 226, 214] },
    "ember-violet": { "a": [226, 98, 70], "b": [140, 76, 178], "accent": [248, 178, 150] }
  },
  "variant_order": ["amber-magenta", "teal-indigo", "ember-violet"],

  "vars": {
    "TXTW": "W - 2 * MX",
    "BASE": "H - 150"
  },

  "type": {
    "wordmark": { "font": "sans", "weight": "SemiBold", "size": 24, "tracking": 3, "color": "text" },
    "pagenum": { "font": "sans", "weight": "Medium", "size": 24, "color": "muted" },
    "handle": { "font": "sans", "weight": "Medium", "size": 23, "color": "muted" },
    "cue": { "font": "sans", "weight": "SemiBold", "size": 28, "color": "accent" },
    "badge": { "font": "sans", "weight": "SemiBold", "size": 25, "tracking": 1, "color": "accent" },
    "title": { "font": "sans", "weight": "Bold", "size": 92, "leading": 100, "color": "text" },
    "subtitle": { "font": "sans", "weight": "Medium", "size": 38, "leading": 50, "color": "dim" },
    "number": { "font": "sans", "weight": "Bold", "size": 96, "leading": 96, "color": "accent" },
    "headline": { "font": "sans", "weight": "Bold", "size": 58, "leading": 70, "color": "text" },
    "body": { "font": "sans", "weight": "Regular", "size": 38, "leading": 56, "color": "dim" },
    "question": { "font": "sans", "weight": "Bold", "size": 62, "leading": 76, "color": "text" },
    "save": { "font": "sans", "weight": "Medium", "size": 38, "leading": 56, "color": "dim" },
    "follow": { "font": "sans", "weight": "SemiBold", "size": 46, "color": "accent" }
  },

  "slides": {
    "cover": [
      { "op": "wash", "strength": 0.62, "resolution": 0.2, "blobs": [
        { "x": 750, "y": 350, "r": 600, "color": "a", "alpha": 210 },
        { "x": 300, "y": 750, "r": 550, "color": "b", "alpha": 190 },
        { "x": 950, "y": 1050, "r": 650, "color": "a", "alpha": 150 },
        { "x": 550, "y": 1250, "r": 600, "color": "b", "alpha": 170 }
      ] },
      { "op": "vscrim", "top": 30, "bottom": 205 },

      { "op": "ellipse", "x": "MX + 8", "y": 98, "r": 8, "fill": "accent" },
      { "op": "text", "value": "$wordmark", "type": "wordmark", "x": "MX + 30", "y": 86, "advance": false },

      { "op": "measure", "name": "t", "value": "$title", "type": "title" },
      { "op": "measure", "name": "s", "value": "$subtitle", "type": "subtitle" },
      { "op": "cursor", "to": "BASE - (56 + 30 + t_h + 18 + s_h)" },

      { "op": "pill", "value": "$badge", "type": "badge", "uppercase": true,
        "x": "MX", "y": { "after": 0 }, "outline": "accent", "radius": 25,
        "height": 50, "pad_x": 25, "pad_y": 11, "advance": false },
      { "op": "cursor", "by": 86 },

      { "op": "text", "value": "$title", "type": "title", "x": "MX", "y": { "after": 0 } },
      { "op": "text", "value": "$subtitle", "type": "subtitle", "x": "MX", "y": { "after": 18 } },

      { "op": "text", "value": "$handle", "type": "handle", "x": "MX", "y": "H - 66", "advance": false },
      { "op": "text", "value": "$scroll", "type": "cue", "x": "MX", "y": "H - 70",
        "align": "right", "advance": false }
    ],

    "secret": [
      { "op": "wash", "strength": 0.55, "resolution": 0.2, "blobs": [
        { "x": 900, "y": 200, "r": 550, "color": "a", "alpha": 200 },
        { "x": 1050, "y": 550, "r": 450, "color": "b", "alpha": 170 }
      ], "note": "the bloom sits top-right, away from the copy" },
      { "op": "vscrim", "top": 150, "bottom": 120 },

      { "op": "ellipse", "x": "MX + 8", "y": 98, "r": 8, "fill": "accent" },
      { "op": "text", "value": "$wordmark", "type": "wordmark", "x": "MX + 30", "y": 86, "advance": false },
      { "op": "text", "value": "{index:02d} / {count:02d}", "type": "pagenum", "x": "MX", "y": 88,
        "align": "right", "advance": false },

      { "op": "text", "value": "{index:02d}", "type": "number", "x": "MX - 2", "y": 168, "advance": false },
      { "op": "line", "x1": "MX + 2", "y1": 290, "x2": "MX + 88", "y2": 290, "color": "accent", "width": 4 },

      { "op": "measure", "name": "h", "value": "$headline", "type": "headline" },
      { "op": "measure", "name": "b", "value": "$body", "type": "body" },
      { "op": "panel", "box": ["MX - 28", 310, "W - MX + 28", "336 + (h_h + 26 + b_h) + 26"],
        "color": "scrim", "alpha": 150, "radius": 34, "blur": 6 },

      { "op": "text", "value": "$headline", "type": "headline", "x": "MX", "y": 336 },
      { "op": "text", "value": "$body", "type": "body", "x": "MX", "y": { "after": 26 } },

      { "op": "text", "value": "$handle", "type": "handle", "x": "MX", "y": "H - 66", "advance": false },
      { "op": "text", "value": "→", "type": "cue", "x": "MX", "y": "H - 70",
        "align": "right", "advance": false }
    ],

    "cta": [
      { "op": "wash", "strength": 0.7, "resolution": 0.2, "blobs": [
        { "x": 540, "y": 675, "r": 750, "color": "a", "alpha": 210 },
        { "x": 540, "y": 675, "r": 450, "color": "b", "alpha": 200 },
        { "x": 540, "y": 675, "r": 250, "color": "accent", "alpha": 150 }
      ], "note": "concentric blooms centre the eye on the question" },
      { "op": "vscrim", "top": 60, "bottom": 150 },

      { "op": "ellipse", "x": "MX + 8", "y": 98, "r": 8, "fill": "accent" },
      { "op": "text", "value": "$wordmark", "type": "wordmark", "x": "MX + 30", "y": 86, "advance": false },

      { "op": "measure", "name": "q", "value": "$question", "type": "question" },
      { "op": "cursor", "to": "int((H - (40 + q_h + 40 + 56 + 60)) / 2) + 20" },

      { "op": "ellipse", "x": "W / 2", "y": { "after": 7 }, "r": 7, "fill": "accent" },
      { "op": "cursor", "by": 33 },

      { "op": "text", "value": "$question", "type": "question", "x": "MX",
        "y": { "after": 0 }, "align": "center" },
      { "op": "text", "value": "$save", "type": "save", "x": "MX",
        "y": { "after": 40 }, "align": "center" },
      { "op": "text", "value": "$follow", "type": "follow", "x": "MX",
        "y": { "after": 0 }, "align": "center" }
    ]
  }
}

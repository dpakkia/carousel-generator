{
  "name": "v4",
  "label": "Editorial Brutalist",
  "extends": "_base",
  "meta": {
    "description": "A hard structural grid: cream blocks inside a thin frame, a mono masthead, one signal-red marker. The blocks are their own scrim, so copy stays legible over any plate.",
    "tags": ["light-blocks", "structural", "mono"]
  },

  "canvas": { "margin": 72 },

  "palette": {
    "scrim": [18, 19, 22],
    "ink": [24, 25, 28],
    "ink_soft": [78, 78, 82],
    "paper": [236, 231, 221],
    "paper_hi": [245, 241, 233],
    "paper_lo": [222, 216, 204],
    "signal": [214, 68, 52],
    "onpaper": [120, 116, 108],
    "text": [236, 231, 221]
  },

  "vars": {
    "PAD": 48,
    "COL": "W - 2 * 72 - 2 * 48",
    "TXTW": "W - 2 * 72 - 2 * 48",
    "TX": "72 + 48"
  },

  "type": {
    "masthead": { "font": "mono", "variant": "bold", "size": 26, "tracking": 3, "color": "ink" },
    "page": { "font": "mono", "variant": "bold", "size": 24, "color": "onpaper" },
    "cue": { "font": "mono", "variant": "bold", "size": 24, "color": "paper" },
    "handle": { "font": "mono", "size": 22, "color": "paper_lo" },
    "badge": { "font": "mono", "variant": "bold", "size": 24, "color": "paper_hi" },
    "title": { "font": "sans", "weight": "Black", "size": 96, "leading": 100, "color": "ink" },
    "subtitle": { "font": "sans", "weight": "Medium", "size": 38, "leading": 50, "color": "ink_soft" },
    "number": { "font": "sans", "weight": "Black", "size": 150, "leading": 150, "color": "ink" },
    "seclabel": { "font": "mono", "variant": "bold", "size": 26, "tracking": 4, "color": "onpaper" },
    "headline": { "font": "sans", "weight": "Black", "size": 60, "leading": 70, "color": "ink" },
    "body": { "font": "sans", "weight": "Regular", "size": 37, "leading": 55, "color": "ink_soft" },
    "question": { "font": "sans", "weight": "Black", "size": 66, "leading": 78, "color": "ink" },
    "save": { "font": "mono", "variant": "bold", "size": 28, "leading": 44, "color": "onpaper" },
    "follow": { "font": "sans", "weight": "Black", "size": 44, "color": "signal" }
  },

  "slides": {
    "cover": [
      { "op": "vscrim", "top": 70, "bottom": 150 },
      { "op": "frame", "inset": "MX", "color": "paper", "width": 3 },

      { "op": "rect", "box": ["MX", "MX", "W - MX", "MX + 66"], "fill": "paper" },
      { "op": "rect", "box": ["MX", "MX + 66", "W - MX", "MX + 72"], "fill": "signal",
        "note": "signal underline pins the masthead to the frame" },
      { "op": "text", "value": "$wordmark", "type": "masthead", "x": "TX - 16", "y": "MX + 19", "advance": false },

      { "op": "measure", "name": "t", "value": "$title", "type": "title", "width": "COL" },
      { "op": "measure", "name": "s", "value": "$subtitle", "type": "subtitle", "width": "COL" },
      { "op": "cursor", "to": "H - MX - 96 - (44 + 56 + 28 + t_h + 22 + s_h) - 2 * PAD" },

      { "op": "rect", "box": ["MX", "cursor", "W - MX", "H - MX - 96"], "fill": "paper" },

      { "op": "pill", "value": "$badge", "type": "badge", "uppercase": true,
        "x": "TX", "y": { "after": "PAD" }, "fill": "signal", "radius": 0,
        "height": 44, "pad_x": 20, "pad_y": 9, "advance": false },
      { "op": "cursor", "by": 72 },

      { "op": "text", "value": "$title", "type": "title", "x": "TX", "y": { "after": 0 }, "width": "COL" },
      { "op": "rect", "box": ["TX", "cursor + 6", "TX + 150", "cursor + 14"], "fill": "signal" },
      { "op": "text", "value": "$subtitle", "type": "subtitle", "x": "TX", "y": { "after": 30 }, "width": "COL" },

      { "op": "text", "value": "SCORRI →", "type": "cue", "x": "MX", "y": "H - MX - 50",
        "width": "W - 2 * MX - PAD + 16", "align": "right", "advance": false },
      { "op": "text", "value": "$handle", "type": "handle", "x": "TX - 16", "y": "H - MX - 50", "advance": false }
    ],

    "secret": [
      { "op": "vscrim", "top": 90, "bottom": 120 },
      { "op": "frame", "inset": "MX", "color": "paper", "width": 3 },

      { "op": "rect", "box": ["MX", "MX", "W - MX", "MX + 66"], "fill": "paper" },
      { "op": "rect", "box": ["MX", "MX + 66", "W - MX", "MX + 72"], "fill": "signal" },
      { "op": "text", "value": "$wordmark", "type": "masthead", "x": "TX - 16", "y": "MX + 19", "advance": false },
      { "op": "text", "value": "{index:02d}/{count:02d}", "type": "page", "x": "MX",
        "y": "MX + 21", "width": "W - 2 * MX - PAD + 16", "align": "right", "advance": false },

      { "op": "measure", "name": "h", "value": "$headline", "type": "headline", "width": "COL" },
      { "op": "measure", "name": "b", "value": "$body", "type": "body", "width": "COL" },
      { "op": "measure", "name": "num", "value": "{index:02d}", "type": "number" },

      { "op": "rect", "box": ["MX", 240, "W - MX", "240 + (150 + 18 + h_h + 26 + b_h) + 2 * PAD"],
        "fill": "paper" },

      { "op": "text", "value": "{index:02d}", "type": "number", "x": "TX - 6", "y": "240 + PAD - 20", "advance": false },
      { "op": "rect", "box": ["TX", "240 + PAD + 152", "TX + 110", "240 + PAD + 160"], "fill": "signal" },
      { "op": "text", "value": "SEGRETO", "type": "seclabel", "x": "TX + num_w + 28",
        "y": "240 + PAD + 18", "advance": false },

      { "op": "cursor", "to": "240 + PAD + 150 + 18" },
      { "op": "text", "value": "$headline", "type": "headline", "x": "TX", "y": { "after": 0 }, "width": "COL" },
      { "op": "text", "value": "$body", "type": "body", "x": "TX", "y": { "after": 26 }, "width": "COL" },

      { "op": "text", "value": "→", "type": "cue", "x": "MX", "y": "H - MX - 50",
        "width": "W - 2 * MX - PAD + 16", "align": "right", "advance": false },
      { "op": "text", "value": "$handle", "type": "handle", "x": "TX - 16", "y": "H - MX - 50", "advance": false }
    ],

    "cta": [
      { "op": "vscrim", "top": 110, "bottom": 150 },
      { "op": "frame", "inset": "MX", "color": "paper", "width": 3 },

      { "op": "rect", "box": ["MX", "MX", "W - MX", "MX + 66"], "fill": "paper" },
      { "op": "rect", "box": ["MX", "MX + 66", "W - MX", "MX + 72"], "fill": "signal" },
      { "op": "text", "value": "$wordmark", "type": "masthead", "x": "TX - 16", "y": "MX + 19", "advance": false },

      { "op": "measure", "name": "q", "value": "$question", "type": "question", "width": "COL" },
      { "op": "cursor", "to": "int((H - ((56 + q_h + 34 + 44 + 56) + 2 * PAD)) / 2) + 20" },

      { "op": "rect", "box": ["MX", "cursor", "W - MX", "cursor + (56 + q_h + 34 + 44 + 56) + 2 * PAD"],
        "fill": "paper" },

      { "op": "rect", "box": ["W / 2 - 80", "cursor + PAD", "W / 2 + 80", "cursor + PAD + 12"], "fill": "signal" },

      { "op": "text", "value": "$question", "type": "question", "x": "TX",
        "y": { "after": "PAD + 56" }, "width": "COL", "align": "center" },
      { "op": "text", "value": "SALVA · SCORRI", "type": "save", "x": "TX",
        "y": { "after": 34 }, "width": "COL", "align": "center" },
      { "op": "text", "value": "SEGUI {handle}", "type": "follow", "x": "TX",
        "y": { "after": 0 }, "width": "COL", "align": "center" }
    ]
  }
}
